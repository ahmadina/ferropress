null="N;"
false="b:0;"
true="b:1;"
int="i:"
int_max="i:9223372036854775807;"
int_min="i:-9223372036854775808;"
float="d:"
nan="NAN"
inf="INF"
neg_inf="-INF"
exponent="E+"
string="s:"
escaped="S:"
escape="\\00"
array="a:"
object="O:"
custom="C:"
enum="E:"
reference="R:"
object_reference="r:"
open=":{"
close="}"
quote_end="\";"
quote_colon="\":"
std_class="O:8:\"stdClass\":"
protected="\x00*\x00"
